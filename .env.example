# pixel-pet-arena — local development environment variables
# Copy to .env and fill in real values. NEVER commit .env to version control.

# PostgreSQL
POSTGRES_DB=pixel_pet_arena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_local

# Email (SendGrid primary; MailHog used automatically in docker-compose dev mode)
SENDGRID_API_KEY=

# GDPR email encryption (AES-256-GCM) — generate with: openssl rand -hex 32
EMAIL_ENCRYPTION_KEY=
