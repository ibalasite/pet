# pixel-pet-arena — local development environment variables
# ⚠️ Updated by gendoc-align-fix gencode from LOCAL_DEPLOY.md
# See docs/LOCAL_DEPLOY.md for detailed setup instructions.
# Copy appropriate sections to apps/api/.env.local, apps/player/.env.local, apps/admin/.env.local

# ── API (apps/api/.env.local) ────────────────────────────────────────────────

# PostgreSQL (printed by `supabase start`, e.g. postgresql://postgres:postgres@localhost:54322/postgres)
POSTGRES_DB=pixel_pet_arena
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_local
DATABASE_URL=

# Redis
REDIS_URL=redis://localhost:6379

# JWT (TOTP setup token signer — generate: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))")
JWT_SECRET=

# Email (SendGrid primary; captured by Supabase Inbucket at http://localhost:54324 locally)
SENDGRID_API_KEY=any-dummy-string-for-local

# GDPR email encryption (AES-256-GCM) — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_ENCRYPTION_KEY=

# Admin TOTP issuer name shown in authenticator app
ADMIN_TOTP_ISSUER=pixel-pet-arena-local

# Runtime feature flags (safe local defaults)
FF_MARKETPLACE=false
FF_ARENA_SUMO=true
FF_RARITY_DISPLAY=true
FF_PET_GENERATION=true
FF_ADMIN_PORTAL=true

# ── Player Frontend (apps/player/.env.local) ─────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000

# ── Admin Frontend (apps/admin/.env.local) ───────────────────────────────────
# VITE_API_BASE_URL=http://localhost:3000
