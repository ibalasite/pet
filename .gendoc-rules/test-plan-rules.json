{
  "step_id": "test-plan",
  "step_name": "Test Plan",
  "output_files": [
    {
      "path": "docs/test-plan.md",
      "must_exist": true,
      "must_not_be_empty": true,
      "min_h2_sections": 10,
      "required_sections": [
        "Test Objectives",
        "Test Scope",
        "Test Cases"
      ],
      "no_bare_placeholders": true,
      "min_words_per_section": 30
    }
  ],
  "anti_fake_rules": [
    {
      "type": "no_placeholder_strings",
      "pattern": "\\{\\{[A-Z_]+\\}\\}"
    },
    {
      "type": "no_duplicate_paragraphs",
      "min_char_length": 150
    },
    {
      "type": "min_section_words",
      "min_words": 30
    },
    {
      "type": "no_trivial_entity_names"
    }
  ]
}