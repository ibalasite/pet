{
  "step_id": "ALIGN-VERIFY",
  "step_name": "Alignment Verification Complete",
  "output_files": [
    {
      "path": "docs/ALIGN-REPORT.md",
      "must_exist": true,
      "must_not_be_empty": true,
      "no_bare_placeholders": true,
      "note": "Zero unresolved issues in final alignment report"
    }
  ],
  "anti_fake_rules": [
    {
      "type": "no_placeholder_strings",
      "pattern": "\\{\\{[A-Z_]+\\}\\}"
    },
    {
      "type": "no_duplicate_paragraphs",
      "min_char_length": 150
    },
    {
      "type": "min_section_words",
      "min_words": 30
    },
    {
      "type": "no_trivial_entity_names"
    }
  ]
}