{
  "step_id": "HTML",
  "step_name": "Static HTML Pages",
  "output_files": [
    {
      "output_glob": "docs/pages/*.html",
      "must_exist": true,
      "min_file_count": 3,
      "no_bare_placeholders": true
    }
  ],
  "anti_fake_rules": [
    {
      "type": "no_placeholder_strings",
      "pattern": "\\{\\{[A-Z_]+\\}\\}"
    },
    {
      "type": "no_duplicate_paragraphs",
      "min_char_length": 150
    },
    {
      "type": "min_section_words",
      "min_words": 30
    },
    {
      "type": "no_trivial_entity_names"
    }
  ]
}