{
  "step_id": "PRD",
  "step_name": "Product Requirements Document",
  "output_files": [
    {
      "path": "docs/PRD.md",
      "must_exist": true,
      "must_not_be_empty": true,
      "min_h2_sections": 5,
      "required_sections": [
        "User Stories",
        "Acceptance Criteria",
        "Out of Scope"
      ],
      "no_bare_placeholders": true,
      "min_words_per_section": 30
    }
  ],
  "anti_fake_rules": [
    {
      "type": "no_placeholder_strings",
      "pattern": "\\{\\{[A-Z_]+\\}\\}"
    },
    {
      "type": "no_duplicate_paragraphs",
      "min_char_length": 150
    },
    {
      "type": "min_section_words",
      "min_words": 30
    },
    {
      "type": "no_trivial_entity_names"
    }
  ]
}