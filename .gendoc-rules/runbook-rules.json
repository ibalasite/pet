{
  "step_id": "runbook",
  "step_name": "Operations Runbook",
  "output_files": [
    {
      "path": "docs/runbook.md",
      "must_exist": true,
      "must_not_be_empty": true,
      "min_h2_sections": 4,
      "required_sections": [
        "Deployment",
        "Incident Response",
        "Rollback"
      ],
      "no_bare_placeholders": true,
      "min_words_per_section": 30
    }
  ],
  "anti_fake_rules": [
    {
      "type": "no_placeholder_strings",
      "pattern": "\\{\\{[A-Z_]+\\}\\}"
    },
    {
      "type": "no_duplicate_paragraphs",
      "min_char_length": 150
    },
    {
      "type": "min_section_words",
      "min_words": 30
    },
    {
      "type": "no_trivial_entity_names"
    }
  ]
}