{
  "step_id": "BDD-server",
  "step_name": "BDD Server Feature Files",
  "output_files": [
    {
      "output_glob": "features/server/*.feature",
      "must_exist": true,
      "min_scenario_count": 15,
      "no_bare_placeholders": true
    }
  ],
  "anti_fake_rules": [
    {
      "type": "no_placeholder_strings",
      "pattern": "\\{\\{[A-Z_]+\\}\\}"
    },
    {
      "type": "no_duplicate_paragraphs",
      "min_char_length": 150
    },
    {
      "type": "min_section_words",
      "min_words": 30
    },
    {
      "type": "no_trivial_entity_names"
    }
  ]
}