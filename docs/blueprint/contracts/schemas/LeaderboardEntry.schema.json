{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://pixel-pet-arena.contracts/LeaderboardEntry",
  "title": "LeaderboardEntry",
  "type": "object",
  "required": [
    "rank",
    "petId",
    "petName",
    "score",
    "winRate",
    "rarity",
    "level"
  ],
  "properties": {
    "rank": {
      "type": "integer",
      "minimum": 1,
      "description": "Current leaderboard rank position (1 = top).",
      "example": 7
    },
    "petId": {
      "type": "string",
      "format": "uuid",
      "description": "Pet identifier (member of the leaderboard:global Redis sorted set).",
      "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
    },
    "petName": {
      "type": "string",
      "maxLength": 64,
      "description": "Display name of the pet.",
      "example": "Crimson Thornback"
    },
    "score": {
      "type": "number",
      "description": "Arena score used as the Redis sorted set score: winRate × battlesPlayed × levelMultiplier.",
      "example": 1248.75
    },
    "winRate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Win rate as a decimal fraction (0.0–1.0).",
      "example": 0.72
    },
    "rarity": {
      "type": "string",
      "enum": ["COMMON", "RARE", "EPIC", "LEGENDARY"],
      "description": "Pet rarity tier.",
      "example": "EPIC"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "description": "Current pet level.",
      "example": 18
    },
    "battlesPlayed": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of completed arena battles.",
      "example": 50
    },
    "winCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of arena wins.",
      "example": 36
    }
  },
  "additionalProperties": false
}
